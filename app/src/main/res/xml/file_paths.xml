<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths FileProvider is allowed to serve as content:// URIs.
  There is ONE FileProvider in AndroidManifest.xml, so every shareable
  folder must be listed here:
    - library_books/ (files dir)  : downloaded HTML book files
                                    (LibraryHtmlBookRepository.getShareableUri)
    - updates/       (cache dir)  : downloaded app-update APK
                                    (ShellActivity.startDownloadAndInstall)
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="library_books" path="library_books/" />
    <cache-path name="apk_updates" path="updates/" />
</paths>
