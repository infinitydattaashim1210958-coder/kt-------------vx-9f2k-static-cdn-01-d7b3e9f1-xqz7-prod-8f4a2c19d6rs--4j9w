<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Audio streaming -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Already present – skip if exists -->

    <!-- Foreground service for background audio -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Keep CPU awake while audio plays (screen off) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+ notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- For posting update notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed to install the downloaded APK update -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SwadhyayApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Swadhyay">
        <activity
            android:name=".presentation.shell.ShellActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay" />
        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Swadhyay.Splash">
            <intent-filter>
              <action android:name="android.intent.action.MAIN" />
              <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay" />
        <activity
            android:name=".presentation.reader.ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay.NoBar" />
        <activity
            android:name=".presentation.library.LibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay" />
        <activity
            android:name=".presentation.library.RabindraPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay" />
        <activity
            android:name=".presentation.library.LibraryDbBookReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay" />
        <activity
            android:name=".presentation.library.LibraryHtmlBookReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay.NoBar" />
        <activity
            android:name=".presentation.ramayana.RamayanaActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay.NoBar" />
        <activity
            android:name=".presentation.mahabharata.MahabharataActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay.NoBar" />
        <activity
            android:name=".presentation.gita.GitaActivity"
            android:exported="false"
            android:theme="@style/Theme.Swadhyay.NoBar" />
        <service
            android:name=".service.MantraPlayerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!--
          Needed to open a downloaded library HTML book via ACTION_VIEW in
          the system browser (LibraryHtmlBookRepository) — a raw file://
          Uri pointing at internal app storage is blocked
          (FileUriExposedException) on API 24+; content:// via FileProvider
          is required instead. Authority uses ${applicationId} so it
          resolves correctly for both the dev and prod flavors
          (RISK_REGISTER.md R1) rather than being hardcoded to one.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    
        <!-- FileProvider: makes the downloaded APK file securely readable
             by the system PackageInstaller without exposing the file path -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- WorkManager uses RECEIVE_BOOT_COMPLETED to reschedule workers
             after device reboot — declared here so the manifest merger
             doesn't create a duplicate. -->
        <receiver
            android:name="androidx.work.impl.background.systemalarm.RescheduleReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
